# frozen_string_literal: true

source 'https://rubygems.org'

# Ruby-GNOME bindings. gtk4 pulls in gdk4/gdk_pixbuf2/pango/cairo-gobject/
# gobject-introspection/gio2/glib2 transitively; adwaita pulls in gtk4.
gem 'adwaita', '~> 4.3'
gem 'gtk4', '~> 4.3'

# Config persistence (frogr keeps its settings in XML, as the C version did).
gem 'rexml', '~> 3.4'
